# =============================================================================
# Builder stage - Build React app with Vite
# =============================================================================
FROM node:22-bookworm-slim AS builder

WORKDIR /build

# Copy package files first for better layer caching
COPY package*.json ./

# Install all dependencies (including devDependencies for build)
RUN npm ci

# Copy source code
COPY . .

# Build the production bundle
RUN npm run build -- --mode production || npx vite build

# =============================================================================
# Runtime stage - Serve with Nginx
# =============================================================================
FROM nginx:1.27-alpine

# Create non-root user directories and set permissions
RUN mkdir -p /tmp/client_temp /tmp/proxy_temp /tmp/fastcgi_temp /tmp/uwsgi_temp /tmp/scgi_temp && \
    chown -R 1000:1000 /tmp && \
    chown -R 1000:1000 /var/cache/nginx && \
    chown -R 1000:1000 /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R 1000:1000 /var/run/nginx.pid && \
    chown -R 1000:1000 /usr/share/nginx/html

# Copy built assets from builder stage
COPY --from=builder --chown=1000:1000 /build/dist /usr/share/nginx/html

# Copy nginx configuration
COPY --chown=1000:1000 nginx.conf /etc/nginx/nginx.conf

# Run as non-root user
USER 1000

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
