# Terraform files to ignore

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
# Override files as they are usually used to override resources locally
*.tfvars
!environments/*.tfvars

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock file (optional - some teams prefer to commit this)
# .terraform.lock.hcl

# Ignore any .pem files
*.pem
